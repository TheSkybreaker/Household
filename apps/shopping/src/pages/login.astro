---
import Icon from '../components/Icon.astro';
import Page from '../components/Page.astro';
---

<Page page="login">
  <div class="app" x-data="loginPage" x-cloak>
    <main class="login">
      <div class="login-mark"><Icon name="basket" /></div>
      <h1>Spesa</h1>
      <p class="login-sub">La lista della spesa di casa, aggiornata in tempo reale su tutti e due i telefoni.</p>
      <form @submit.prevent="submit()">
        <label class="field">Nome utente<input x-model="username" autocomplete="username" autocapitalize="none" spellcheck="false" required /></label>
        <label class="field">Password<input type="password" x-model="password" autocomplete="current-password" required /></label>
        <button class="btn primary wide" type="submit" :disabled="busy">Entra</button>
        <p class="login-error" role="alert" x-show="error" x-text="error"></p>
      </form>
    </main>
  </div>
</Page>
