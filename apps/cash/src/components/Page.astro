---
import '@household/shared/fonts.css';
import '../styles/tokens.css';
import '@household/shared/base.css';
import '../styles/base.css';

interface Props {
  page: 'login' | 'home';
}

const { page } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#36C49D" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <title>Conti</title>
  </head>
  <body data-page={page}>
    <slot />
  </body>
</html>
