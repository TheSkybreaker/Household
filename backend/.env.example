# Generate the key pair once with `go run . vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address or https URL for the push services.
VAPID_SUBJECT=
# 1 enables /api/push/test and automigrate.
DEV=1
# Domain of the auth cookie the apps share: .skybreaker.dev in production, required unless DEV=1.
COOKIE_DOMAIN=
# Time zone of "today" and of the Conti month close.
APP_TZ=Europe/Rome
